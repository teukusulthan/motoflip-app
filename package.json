{
  "name": "motoflip",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.x"
  },
  "scripts": {
    "dev": "NEXT_DIST_DIR=.next-dev next dev -p 3100",
    "build": "next build",
    "start": "next start -p ${PORT:-3100}",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
