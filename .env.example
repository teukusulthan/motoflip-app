# --- Database -------------------------------------------------------------
DATABASE_URL="postgresql://motoflip_dev@127.0.0.1:5433/motoflip_dev?schema=public"

# --- Session --------------------------------------------------------------
# 32+ byte random string. Generate: openssl rand -base64 48
SESSION_SECRET="change-me-to-a-long-random-string-at-least-32-bytes"

# --- Cloudinary (photos + documents) --------------------------------------
# Optional in local dev: uploads fall back to local disk when unset.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- Bootstrap the single operator account (seed only) ---------------------
SEED_USER_EMAIL="admin@motoflip.local"
SEED_USER_PASSWORD="motoflip123"
SEED_USER_NAME="Operator"

# --- Integrations (Composio) ----------------------------------------------
# Optional. Without these the Integrations page and assistant stay disabled;
# the rest of the application is unaffected.
# Get a key at https://app.composio.dev
COMPOSIO_API_KEY=""
# Required for the assistant to run tools. https://console.anthropic.com
ANTHROPIC_API_KEY=""
